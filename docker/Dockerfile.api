FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    WILDFIRE_DEVICE=cpu \
    WILDFIRE_MODEL_ARCH=temporal_multimodal_efficientnet_b0 \
    WILDFIRE_MODEL_PATH_TEMPORAL_MULTIMODAL_EFFICIENTNET_B0=artifacts/multimodal/multimodal_model_best.pth \
    WILDFIRE_REFERENCE_STATS_PATH=artifacts/exp4/reference_stats.json \
    WEB_CONCURRENCY=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 user
ENV HOME=/home/user
ENV PATH=/home/user/.local/bin:$PATH
WORKDIR $HOME/app

COPY --chown=user requirements.api.txt pyproject.toml README.md ./
COPY --chown=user src ./src
COPY --chown=user api ./api
COPY --chown=user artifacts ./artifacts
COPY --chown=user wildfire_model.pth ./
COPY --chown=user docker/start_api.sh ./docker/start_api.sh

RUN pip install --upgrade pip \
    && pip install -r requirements.api.txt \
    && pip install --no-deps -e . \
    && chmod +x ./docker/start_api.sh

USER user

EXPOSE 8000

CMD ["./docker/start_api.sh"]
